# Database — matches docker-compose.yml defaults; override for managed/remote DB
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hunch?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# LLM — Claude routed via OpenRouter (Mastra `openrouter/...` model router)
OPENROUTER_API_KEY="sk-or-v1-..."

# Email — 2FA sign-in codes. Provider resolved in order: Brevo, then Resend,
# then console-log (fine for local dev; no account needed).
#
# Brevo (free 300/day, no domain, no card): create a key at
# app.brevo.com > SMTP & API, verify your sender email under Senders, then set
# EMAIL_FROM to that verified address.
BREVO_API_KEY=""
# Resend alternative (needs a verified domain to reach arbitrary recipients).
RESEND_API_KEY=""
# From-address. For Brevo this MUST be a verified sender email.
EMAIL_FROM="Hunch <onboarding@resend.dev>"
