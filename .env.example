# Database — matches docker-compose.yml defaults; override for managed/remote DB
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hunch?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# LLM — Claude Sonnet 5 on Amazon Bedrock (@ai-sdk/amazon-bedrock).
# Credentials resolve through the standard AWS chain: for local dev, point
# AWS_PROFILE at a named profile (`aws configure --profile <name>`) so secrets
# stay in ~/.aws; in CI/prod use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an
# attached IAM role instead. The profile/role needs bedrock:InvokeModel on the
# Claude Sonnet 5 inference profile.
AWS_REGION="us-west-2"
AWS_PROFILE="gav-bedrock"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# Override the model only if you use a different Bedrock inference profile.
# BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-5"

# Email — 2FA sign-in codes. Provider resolved as: Resend if RESEND_API_KEY is
# set, else console-log (fine for local dev; no account needed).
#
# Resend (free, sign up with Google — no domain, no card): create a
# send-scoped key at resend.com > API Keys. Without a verified domain the shared
# onboarding@resend.dev sender delivers ONLY to your own Resend account email;
# verify a domain to reach any recipient (then set EMAIL_FROM to that domain).
RESEND_API_KEY=""
# From-address. Leave as the default unless you've verified your own domain.
EMAIL_FROM="Hunch <onboarding@resend.dev>"
