# Database — matches docker-compose.yml defaults; override for managed/remote DB
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hunch?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Dev-only: skip sign-in entirely and run as a stable "dev-user" (created on
# first request). Handy for iterating without logging in each reload. Ignored
# when NODE_ENV=production, so it can never bypass auth in a real deploy.
# DEV_AUTH_BYPASS="1"

# LLM — Claude Sonnet 5 through OpenRouter (@ai-sdk/openai-compatible).
# Create a key at openrouter.ai > Keys. That key is the whole setup: OpenRouter
# speaks the OpenAI wire format, so there's no cloud account or credential chain
# behind it. Without it the agents fail on the first call, and the `.eval` tests
# self-skip.
OPENROUTER_API_KEY="sk-or-..."
# Override only to run the agents on a different OpenRouter model.
# OPENROUTER_MODEL_ID="anthropic/claude-sonnet-5"

# Email — 2FA sign-in codes and the daily reminder. Provider resolved as: Resend if RESEND_API_KEY is
# set, else console-log (fine for local dev; no account needed).
#
# Resend (free, sign up with Google — no domain, no card): create a
# send-scoped key at resend.com > API Keys. Without a verified domain the shared
# onboarding@resend.dev sender delivers ONLY to your own Resend account email;
# verify a domain to reach any recipient (then set EMAIL_FROM to that domain).
RESEND_API_KEY=""
# From-address. Leave as the default unless you've verified your own domain.
EMAIL_FROM="Hunch <onboarding@resend.dev>"

# Reminders — the daily nudge runs on Inngest (src/inngest). Locally the dev
# server does everything and no keys are needed; INNGEST_DEV=1 is what tells the
# SDK to talk to it rather than to Inngest Cloud. Without it the serve route at
# /api/inngest returns 500 ("in cloud mode but no signing key").
#
#   npm run dev
#   npx --ignore-scripts=false inngest-cli@latest dev -u http://localhost:3000/api/inngest
#
# In production, drop INNGEST_DEV and set the two keys from the Inngest
# dashboard instead. BETTER_AUTH_URL is what the links in the emails are built
# from, so it has to be the real origin there.
INNGEST_DEV="1"
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
